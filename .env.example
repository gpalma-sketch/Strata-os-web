# Copy to `.env` and fill in. Only PUBLIC_* vars reach the browser — this file
# holds no secrets, because a static build cannot keep one.

# --- STRATA OS launch waitlist (email only) ---
# Where the "join the launch list" form POSTs. Any endpoint that accepts a
# FormData POST and returns 2xx works: Formspree, Basin, Web3Forms, Netlify
# Forms, Mailchimp, Beehiiv, or your own.
#
# Leave it empty and the form is replaced by a mailto: link, so a signup is
# never silently dropped.
#
# Example (Formspree):
# PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/xxxxxxxx
PUBLIC_WAITLIST_ENDPOINT=

# --- STRATA Lab diagnosis enquiries (full form) ---
# Same contract, separate endpoint so launch-list emails and real sales leads
# don't land in one pile. Empty → the form is not rendered and the CTA falls
# back to mailto:.
PUBLIC_CONTACT_ENDPOINT=
