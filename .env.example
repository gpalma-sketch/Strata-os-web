# Copia esto a `.env` para desarrollo, y configura las mismas variables en
# Vercel (Settings → Environment Variables) para producción.
#
# Solo las que empiezan por PUBLIC_ llegan al navegador. Las demás se leen en
# el servidor, dentro de las rutas /api/*, y nunca salen de ahí.

# ---------------------------------------------------------------------------
# Supabase — dónde acaban los formularios
# ---------------------------------------------------------------------------
# Sin estas dos, /api/waitlist y /api/contact devuelven 503 a propósito: es
# preferible a un 200 mentiroso, porque el formulario enseña entonces su
# mensaje de error con la dirección de correo y nadie se queda sin vía.
#
# ⚠️ El proyecto tiene que ser `strata-os` (eu-central-1). Es donde están
# creadas las funciones `submit_waitlist` y `submit_contact` y las tablas del
# esquema `marketing`. Si apuntas a otro proyecto de Supabase, las llamadas
# fallarán con un 404 porque ahí esas funciones no existen.
SUPABASE_URL=https://vikyzqpayddubhrtxiyw.supabase.co

# La clave `service_role`, en Supabase → Settings → API Keys.
# Es secreta: no la subas al repositorio ni la pegues en un chat. Solo la usa
# la función de servidor, así que nunca llega al bundle del navegador.
#
# Aun filtrada, no permite leer la lista: el rol tiene permiso para ejecutar
# las dos funciones y ninguno de SELECT sobre las tablas.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Precios — de dónde sale la tarifa (STR-224)
# ---------------------------------------------------------------------------
# NO HACE FALTA CONFIGURAR NADA. El valor por defecto está en src/lib/precios.ts
# y apunta a la Edge Function pública que sirve la tabla `plans` del proyecto
# `business-os`. Es información pública —son los precios de la web—, así que ese
# endpoint no lleva token ni clave: la respuesta correcta a «cómo autentico
# esto» era que no hubiera nada que autenticar.
#
# ⚠️ Es OTRO proyecto de Supabase, no el de arriba. El de arriba (`strata-os`)
# guarda los formularios; la tarifa vive en `business-os`, que es donde la leen
# también el panel del cliente y los agentes. Una copia de `plans` aquí sería
# exactamente el problema que esto vino a cerrar.
#
# La tarifa se lee en el BUILD. Si no responde, el build FALLA a propósito: una
# web que no se despliega se nota en un minuto, y una con el precio de hace tres
# meses no se nota hasta que la ve un cliente. Un cambio en `plans` dispara el
# redespliegue solo (trigger `trg_plans_publicar`), así que no hay que tocar
# nada aquí para publicar un precio nuevo.
#
# Rellénala sólo para apuntar a un entorno de pruebas.
PRECIOS_URL=

# ---------------------------------------------------------------------------
# Opcional — mover los formularios a un servicio externo
# ---------------------------------------------------------------------------
# Vacías, los formularios envían a las rutas propias del sitio (/api/waitlist
# y /api/contact), que es lo que quieres: los datos se quedan en la UE y el
# navegador solo habla con stratalabai.com.
#
# Rellenarlas redirige el envío a un tercero (Formspree, Beehiiv, Mailchimp…).
# Si lo haces, hay que declararlo como encargado del tratamiento en
# src/data/legal.ts y en la política de privacidad.
PUBLIC_WAITLIST_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=
