---
import '../styles/global.css';
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { content } from '../data/content';

interface Props {
  locale: Locale;
  /** Sobrescribe el <title>. Por defecto, el de la portada. */
  title?: string;
  /** Sobrescribe la meta description. */
  description?: string;
  /** Ruta sin prefijo de idioma, p. ej. '/privacidad'. Vacío = portada. */
  path?: string;
  /** Excluye la página de los buscadores (documentos legales incompletos). */
  noindex?: boolean;
}
const { locale, title, description, path = '', noindex = false } = Astro.props;
const t = content[locale];

const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;

// El prefijo /en aplica a todas las rutas, no solo a la portada.
const esHref = new URL(path || '/', Astro.site).href;
const enHref = new URL(`/en${path}`, Astro.site).href;
const canonical = locale === 'es' ? esHref : enHref;
const alternates: Array<[string, string]> = [
  ['es', esHref],
  ['en', enHref],
  ['x-default', esHref],
];

// Organisation markup so the brand, the two product lines and the contact
// route are machine-readable. Kept in sync with src/data/site.ts.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: new URL('/', Astro.site).href,
  description: t.meta.description,
  email: site.email,
  logo: new URL('/strata-mark.svg', Astro.site).href,
  founder: t.team.members.map((m) => ({ '@type': 'Person', name: m.name, jobTitle: m.role })),
  makesOffer: t.pillars.items.map((p) => ({
    '@type': 'Offer',
    name: p.name,
    description: p.summary,
  })),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0A1620" />
    <link rel="icon" href="/strata-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Tipografías auto-alojadas — ver src/styles/fonts.css. Sin conexión a
        Google, así que no se transfiere la IP del visitante a un tercero.
        Solo se precargan las dos caras visibles en el primer viewport. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-800-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-400-latin.woff2" crossorigin />

    {!path && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#top">{t.nav.skipToContent}</a>
    <slot />
  </body>
</html>
