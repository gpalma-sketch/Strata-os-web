---
/**
 * La barra de navegación, compartida por la portada y las cinco páginas.
 *
 * Las entradas ya no son anclas de una sola página larga: son cinco páginas de
 * verdad, y salen del mapa (`src/data/rutas.ts`), no de una lista escrita aquí
 * ni en `es.ts`. Así el menú, el selector de idioma y el sitemap no pueden
 * decir cosas distintas de la misma página.
 */
import Icon from './Icon.astro';
import type { Locale } from '../data/site';
import { localePath } from '../data/site';
import { content } from '../data/content';
import { enlacesMenu, claveDeRuta, rutaEquivalente } from '../data/rutas';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale];
const home = localePath(locale);

const enlaces = enlacesMenu(locale);
// Para marcar la página en la que estás. `claveDeRuta` devuelve null en la
// portada y en las legales, así que allí no se marca ninguna: correcto.
const actual = claveDeRuta(Astro.url.pathname);

// EL SELECTOR ES/EN. Antes mandaba siempre a la portada: quien leía precios y
// pulsaba EN perdía la página. Ahora salta a la equivalente (/precios →
// /en/pricing) y, fuera del mapa, a la misma ruta en el otro idioma.
const hrefEs = rutaEquivalente(Astro.url.pathname, 'es');
const hrefEn = rutaEquivalente(Astro.url.pathname, 'en');

/**
 * EL CTA «Hablemos» NO PUEDE QUEDARSE COLGADO.
 *
 * Antes era `href="#contacto"` a secas, que funcionaba porque sólo existía una
 * página y esa sección estaba dentro. En /precios no hay ningún #contacto que
 * valga salvo que la página lo incluya, así que el href de partida apunta a la
 * portada — un enlace que SIEMPRE resuelve, incluso sin JavaScript.
 *
 * Encima, el script de abajo lo reescribe a '#contacto' cuando la sección sí
 * está en la página actual (portada, y las cinco páginas que terminan en
 * `CierrePagina`), para que el salto sea instantáneo y no recargue. Es mejora
 * progresiva: si el script no corre, el enlace sigue llevando al mismo sitio.
 */
const hrefContacto = `${home}#contacto`;
---

<nav class="nav">
  <div class="wrap">
    <a href={`${home}#top`} class="brand">
      <svg viewBox="0 0 64 64" role="img" aria-label="STRATA">
        <rect width="64" height="64" rx="14" fill="#35D0BA"></rect>
        <g fill="#0A1620">
          <rect x="14" y="40" width="36" height="8" rx="2"></rect>
          <rect x="14" y="28" width="28" height="8" rx="2"></rect>
          <rect x="14" y="16" width="20" height="8" rx="2"></rect>
        </g>
      </svg>
      STRATA
    </a>

    <div class="nav-links">
      {
        enlaces.map((l) => (
          <a href={l.href} aria-current={l.clave === actual ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>

    <a href={hrefContacto} data-cta-contacto class="btn btn-primary nav-cta">{t.nav.cta}</a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="navDrawer"
      aria-label={t.nav.menuLabel}
    >
      <Icon name="menu" class="ico-open" />
      <Icon name="close" class="ico-close" />
    </button>

    <div class="langsel">
      <a href={hrefEs} aria-current={locale === 'es' ? 'true' : undefined} hreflang="es">ES</a>
      <a href={hrefEn} aria-current={locale === 'en' ? 'true' : undefined} hreflang="en">EN</a>
    </div>

    <div id="progress"></div>
  </div>
</nav>

<div class="nav-drawer" id="navDrawer">
  {
    enlaces.map((l) => (
      <a class="dlink" href={l.href} aria-current={l.clave === actual ? 'page' : undefined}>
        {l.label}
      </a>
    ))
  }
  <div class="dfoot">
    <a href={hrefContacto} data-cta-contacto class="btn btn-primary">{t.nav.cta}</a>
  </div>
</div>

<script>
  // Si la sección de contacto está en ESTA página, el CTA salta dentro sin
  // recargar. Si no está (una legal, o una página que se olvide de incluir
  // `CierrePagina`), el href de partida sigue llevando a la portada — que es
  // el motivo de hacerlo así y no al revés: el enlace nunca queda muerto.
  if (document.getElementById('contacto')) {
    document.querySelectorAll('[data-cta-contacto]').forEach((a) => a.setAttribute('href', '#contacto'));
  }

  const toggle = document.getElementById('navToggle');
  const drawer = document.getElementById('navDrawer');

  if (toggle && drawer) {
    const setOpen = (open: boolean) => {
      drawer.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Any in-page jump closes the drawer, otherwise it covers the target.
    drawer.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    // Crossing back to desktop leaves a stale open drawer behind otherwise.
    matchMedia('(min-width: 981px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  const progress = document.getElementById('progress');
  if (progress) {
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      progress.style.width = `${max > 0 ? (h.scrollTop / max) * 100 : 0}%`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
