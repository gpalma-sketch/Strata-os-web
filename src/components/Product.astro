---
/**
 * El producto: las nueve vistas del Business OS, con capturas reales.
 *
 * Las capturas viven aquí y no en una galería suelta a mitad de página. Ahí no
 * aportaban nada —eran tres imágenes sin contexto—; aquí son la prueba de lo
 * que el texto de al lado está describiendo.
 */
import { Image } from 'astro:assets';
import type { Locale } from '../data/site';
import { content } from '../data/content';

interface Props {
  locale: Locale;
  /**
   * QUÉ NIVEL DE TITULAR PINTA ESTA SECCIÓN. Por defecto `h2`, que es lo
   * correcto cuando la sección es una más dentro de una página que ya tiene su
   * `h1`. Al partir la landing (27 ago 2026) esta sección pasó a ABRIR
   * `/el-os`, y una página cuyo encabezado más alto es un `h2` no declara de
   * qué va: se queda sin `h1`. Medido sobre el build de ese día, las cinco
   * páginas nuevas tenían CERO `h1` — justo las páginas a las que se quiere
   * llegar desde un buscador, que era el motivo de partir la landing.
   *
   * No cambia NADA visualmente: el tamaño lo pone la clase `.h-lg`, y en el CSS
   * no hay ni una regla que mire la etiqueta `h1`/`h2`. Es sólo semántica.
   */
  titular?: 'h1' | 'h2';
}
const { locale, titular: Titular = 'h2' } = Astro.props;
const t = content[locale];

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/os-*.png', { eager: true });
const capturas = t.product.shots
  .map((s) => ({ ...s, img: shots[`../assets/${s.image}`]?.default }))
  .filter((s) => s.img);
---

<section class="deep grid-bg sec" id="producto">
  <div class="orb" style="width:500px; height:500px; top:10%; left:-200px; opacity:.25;"></div>
  <div class="wrap">
    <div class="reveal">
      <p class="kick">{t.product.kicker}</p>
      <Titular class="h-lg" style="margin-top:18px; max-width:880px;">
        {t.product.title[0]}<span class="mint">{t.product.title[1]}</span>
      </Titular>
      <p class="lead" style="margin-top:20px; max-width:720px;">{t.product.lead}</p>
    </div>

    <div class="vistas reveal" data-stagger>
      {
        t.product.vistas.map((v) => (
          <div class="vista">
            <div class="vn">{v.n}</div>
            <div class="vt">{v.title}</div>
            <div class="vs">{v.summary}</div>
          </div>
        ))
      }
    </div>

    {
      capturas.length > 0 && (
        <div class="shots reveal">
          <p class="shots-k">{t.product.shotsLabel}</p>
          <div class="shots-grid" data-stagger>
            {capturas.map((s) => (
              <figure class="shot">
                <Image
                  src={s.img!}
                  alt={s.alt}
                  widths={[760, 1100, 1600, 2200]}
                  sizes="(max-width: 1180px) 92vw, 1100px"
                />
                <figcaption>
                  <b>{s.title}</b>
                  {s.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
