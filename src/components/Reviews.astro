---
/**
 * Customer reviews.
 *
 * Renders nothing while `site.testimonials` is empty — which it is, on
 * purpose. The design prototype shipped three quotes its own author flagged
 * as written "by archetype" rather than collected from customers; publishing
 * invented endorsements as real ones is a fabricated testimonial, and for an
 * EU-facing site an unfair commercial practice under Directive 2005/29/EC
 * Annex I.
 *
 * To turn the section on: add real, attributable quotes (with permission) to
 * `site.testimonials` in src/data/site.ts, drop any photos into src/assets,
 * and this renders exactly as designed.
 */
import { Image } from 'astro:assets';
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { content } from '../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale];

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (file?: string) => (file ? photos[`../assets/${file}`]?.default : undefined);
---

{
  site.testimonials.length > 0 && (
    <section class="deep grid-bg sec" id="opiniones">
      <div class="orb" style="width:460px; height:460px; top:0; right:-160px; opacity:.22;"></div>
      <div class="wrap">
        <div class="reveal">
          <p class="kick">{t.reviews.kicker}</p>
          <h2 class="h-lg" style="margin-top:18px;">
            {t.reviews.title[0]}<span class="mint">{t.reviews.title[1]}</span>
          </h2>
        </div>

        <div class="reviews reveal" data-stagger>
          {site.testimonials.map((r) => {
            const photo = photoFor(r.photo);
            return (
              <figure class="review">
                {r.rating !== undefined && (
                  <div class="stars" role="img" aria-label={`${r.rating}/5`}>
                    {Array.from({ length: Math.round(r.rating) }).map(() => (
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2l3 6.5 7 .9-5 4.7 1.3 7L12 17.8 5.4 21l1.3-7-5-4.7 7-.9z" />
                      </svg>
                    ))}
                  </div>
                )}
                <blockquote class="q">{r.quote}</blockquote>
                <figcaption class="author">
                  {photo && <Image src={photo} alt={r.author} width={96} height={96} />}
                  <div>
                    <div class="an">{r.author}</div>
                    <div class="ar">{r.org}</div>
                  </div>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </div>
    </section>
  )
}
