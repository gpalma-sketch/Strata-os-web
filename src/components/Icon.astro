---
/**
 * Inline icon set, ported 1:1 from the design prototype's hand-drawn SVG
 * paths so the shapes are identical. Inlined rather than sprited because
 * there are only a couple of dozen and they are all above the fold or close
 * to it — a sprite request would cost more than it saves.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;

const paths: Record<string, string> = {
  // outcomes
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  'calendar-check': '<path d="M8 2v4M16 2v4M3 10h18"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="m9 16 2 2 4-4"/>',
  trend: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
  headset: '<path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM2 12h2M20 12h2M12 2v2M12 20v2"/>',
  wallet: '<path d="M20 12V8H6a2 2 0 0 1 0-4h12v4M4 6v12a2 2 0 0 0 2 2h14v-4M18 12a2 2 0 0 0 0 4h4v-4z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  // shared
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  euro: '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  // agents
  chart: '<path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 5-6"/>',
  layers: '<path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>',
  send: '<path d="M3 11l19-9-9 19-2-8-8-2z"/>',
  doc: '<path d="M14 3v5h5M5 3h9l5 5v13H5z"/><path d="M9 13h6M9 17h6"/>',
  // partners
  bank: '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>',
  shield: '<path d="M12 3 4 7v6c0 5 3.5 8 8 11 4.5-3 8-6 8-11V7z"/>',
  people: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 12 0v1M18 12a4 4 0 0 0 3 6"/>',
  node: '<path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19"/>',
  // bento
  'shield-check': '<path d="M12 2 4 5v6c0 5 3.5 8 8 11 4.5-3 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  calendar: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  // use cases + feed
  check: '<path d="M20 6 9 17l-5-5"/>',
  plus: '<path d="M12 8v8M8 12h8"/>',
  bolt: '<path d="M13 2 3 14h7l-1 8 10-12h-7z"/>',
  // chat + nav
  'send-plane': '<path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
};

const d = paths[name];
if (!d) throw new Error(`Icon "${name}" is not defined in Icon.astro`);
---

<svg viewBox="0 0 24 24" class={className} aria-hidden="true" focusable="false" set:html={d} />
