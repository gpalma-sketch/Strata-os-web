---
/**
 * The whole landing page in section order, shared by both locale routes.
 * Section order matches the approved design, con una excepción declarada:
 *
 * FOTOGRAFÍA DECORATIVA FUERA (27 ago 2026). Aquí iban dos <PhotoBand> a
 * sangre — una entre Partners y Pillars, otra entre Cases y Waitlist. Se
 * quitan por decisión de Gonzalo: la fotografía de feria/evento no le
 * convence. Se van la foto Y el pie de foto, porque el pie ("Empresas como la
 * tuya…", "Lo contamos donde nos dejan…") no dice nada sin la imagen debajo.
 *
 * Efecto colateral conocido y aceptado: la primera banda era lo único que
 * partía Partners → Pillars → Why, tres secciones `light` seguidas. Sin ella
 * son ~4.300 px claros de un tirón. Se deja así a propósito: cambiar el tono
 * de una de las tres es una decisión de diseño, no una consecuencia de quitar
 * una foto, y la página ya convive con una racha `deep` más larga todavía
 * (Agentes + Producto, ~4.900 px). Si algún día molesta, se decide aparte.
 *
 * El componente PhotoBand.astro y los .jpg siguen en el repo, sin usar.
 */
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Stats from './Stats.astro';
import Waitlist from './Waitlist.astro';
import Pillars from './Pillars.astro';
import Why from './Why.astro';
import Agents from './Agents.astro';
import Product from './Product.astro';
import Flow from './Flow.astro';
import Engine from './Engine.astro';
import Rollout from './Rollout.astro';
import Permisos from './Permisos.astro';
import UseCases from './UseCases.astro';
import Cases from './Cases.astro';
import Pricing from './Pricing.astro';
import Method from './Method.astro';
import Lab from './Lab.astro';
import Team from './Team.astro';
import Partners from './Partners.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Chat from './Chat.astro';
import Reveal from './Reveal.astro';
import CookieBanner from './CookieBanner.astro';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale}>
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <Stats locale={locale} />
    <Partners locale={locale} />
    <Pillars locale={locale} />
    <Why locale={locale} />
    <Agents locale={locale} />
    <Product locale={locale} />
    <Flow locale={locale} />
    <Engine locale={locale} />
    <Rollout locale={locale} />
    <Permisos locale={locale} />
    <UseCases locale={locale} />
    <Cases locale={locale} />
    <Waitlist locale={locale} />
    <Pricing locale={locale} />
    <Method locale={locale} />
    <Lab locale={locale} />
    <Team locale={locale} />
    <Faq locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <Chat locale={locale} />
  <CookieBanner locale={locale} />
  <Reveal />
</Base>
