---
/**
 * The whole landing page in section order, shared by both locale routes.
 * Section order matches the approved design exactly.
 */
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Stats from './Stats.astro';
import Waitlist from './Waitlist.astro';
import Pillars from './Pillars.astro';
import PhotoBand from './PhotoBand.astro';
import Why from './Why.astro';
import Agents from './Agents.astro';
import Product from './Product.astro';
import Flow from './Flow.astro';
import Engine from './Engine.astro';
import Rollout from './Rollout.astro';
import Permisos from './Permisos.astro';
import UseCases from './UseCases.astro';
import Cases from './Cases.astro';
import Pricing from './Pricing.astro';
import Method from './Method.astro';
import Lab from './Lab.astro';
import Team from './Team.astro';
import Partners from './Partners.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Chat from './Chat.astro';
import Reveal from './Reveal.astro';
import CookieBanner from './CookieBanner.astro';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale}>
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <Stats locale={locale} />
    <Partners locale={locale} />
    <PhotoBand
      image="ban-stand.jpg"
      alt="Tres personas conversando en el stand de una feria del sector"
      caption={locale === 'es'
        ? 'Empresas como la tuya. Con las que hablamos todas las semanas.'
        : 'Companies like yours. The ones we talk to every week.'}
    />
    <Pillars locale={locale} />
    <Why locale={locale} />
    <Agents locale={locale} />
    <Product locale={locale} />
    <Flow locale={locale} />
    <Engine locale={locale} />
    <Rollout locale={locale} />
    <Permisos locale={locale} />
    <UseCases locale={locale} />
    <Cases locale={locale} />
    <PhotoBand
      image="ban-sala.jpg"
      alt="Sala llena de asistentes durante un evento del sector"
      caption={locale === 'es'
        ? 'Lo contamos donde nos dejan. Ahora te toca a ti decidir.'
        : 'We tell this story wherever they let us. Now it is your call.'}
    />
    <Waitlist locale={locale} />
    <Pricing locale={locale} />
    <Method locale={locale} />
    <Lab locale={locale} />
    <Team locale={locale} />
    <Faq locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <Chat locale={locale} />
  <CookieBanner locale={locale} />
  <Reveal />
</Base>
