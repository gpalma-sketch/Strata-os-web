---
/**
 * The whole landing page in section order, shared by both locale routes.
 * Section order matches the approved design exactly.
 */
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Stats from './Stats.astro';
import Waitlist from './Waitlist.astro';
import Pillars from './Pillars.astro';
import Why from './Why.astro';
import Agents from './Agents.astro';
import Product from './Product.astro';
import Flow from './Flow.astro';
import UseCases from './UseCases.astro';
import Cases from './Cases.astro';
import Pricing from './Pricing.astro';
import Method from './Method.astro';
import Lab from './Lab.astro';
import Reviews from './Reviews.astro';
import Gallery from './Gallery.astro';
import Team from './Team.astro';
import Photos from './Photos.astro';
import PhotoBand from './PhotoBand.astro';
import Partners from './Partners.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Chat from './Chat.astro';
import Reveal from './Reveal.astro';
import CookieBanner from './CookieBanner.astro';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale}>
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <Stats locale={locale} />
    <Waitlist locale={locale} />
    <Pillars locale={locale} />
    <Why locale={locale} />
    <Agents locale={locale} />
    <PhotoBand
      image="foto-stand.jpg"
      alt="Equipo de STRATA atendiendo su stand en una feria del sector, rodeado de visitantes"
      caption={locale === 'es' ? 'Vendiendo en persona. Los agentes hacen el resto.' : 'Selling in person. The agents do the rest.'}
    />
    <Product locale={locale} />
    <Flow locale={locale} />
    <UseCases locale={locale} />
    <Cases locale={locale} />
    <PhotoBand
      image="foto-panel.jpg"
      alt="Mesa redonda en un congreso del sector, con el público sentado frente a los ponentes"
      caption={locale === 'es' ? 'Escuchando a quien ya lo ha hecho antes que nosotros.' : 'Listening to the people who did it before us.'}
      size="alta"
    />
    <Pricing locale={locale} />
    <PhotoBand
      image="foto-charla.jpg"
      alt="Asistentes escuchando una charla en una sala pequeña, sentados en círculo"
      caption={locale === 'es' ? 'El método no salió de un despacho.' : 'The method did not come out of an office.'}
    />
    <Method locale={locale} />
    <Lab locale={locale} />
    <Reviews locale={locale} />
    <Gallery locale={locale} />
    <Team locale={locale} />
    <Photos locale={locale} />
    <Partners locale={locale} />
    <Faq locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <Chat locale={locale} />
  <CookieBanner locale={locale} />
  <Reveal />
</Base>
