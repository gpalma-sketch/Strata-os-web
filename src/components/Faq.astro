---
import type { Locale } from '../data/site';
import { content } from '../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale];

// FAQPage markup: these are exactly the questions people search for.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="dark sec" id="faq">
  <div class="wrap">
    <div class="reveal" style="text-align:center;">
      <p class="kick" style="justify-content:center;">{t.faq.kicker}</p>
      <h2 class="h-lg" style="margin-top:18px;">
        {t.faq.title[0]}<span class="mint">{t.faq.title[1]}</span>
      </h2>
    </div>

    <div class="faq reveal">
      {
        t.faq.items.map((f, i) => (
          <div class="qa">
            <h3>
              <button
                class="qq"
                type="button"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`faq-a-${i}`}
                id={`faq-q-${i}`}
              >
                {f.q}
                {/* VACÍO A PROPÓSITO: el icono se DIBUJA en CSS con dos barras (ver `.qi`).
                    Antes aquí había un carácter «+» que se giraba 90° al abrir para convertirse en
                    «−». No funcionaba: un signo «+» girado 90° sigue siendo un signo «+», así que
                    la pregunta abierta llevaba EXACTAMENTE el mismo icono que las cerradas y el
                    acordeón no decía en qué estado estaba. Con dos barras, abrir esconde la
                    vertical y queda un «−» de verdad.
                    `aria-hidden` porque el estado ya lo dice `aria-expanded` en el botón: para
                    quien usa lector de pantalla este icono es ruido, y sin texto dentro no puede
                    quedarse desincronizado con el estado real. */}
                <span class="qi" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="qc" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div><p>{f.a}</p></div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.qa .qq').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', String(btn.getAttribute('aria-expanded') !== 'true'));
    });
  });
</script>
