---
/**
 * Fotografías reales del equipo.
 *
 * Existe por una razón concreta: sin ella, toda la imaginería de la página era
 * degradados, orbes y pantallas dibujadas con código, y eso se lee como una
 * web hecha por una máquina para hablar de máquinas. Tres fotos de gente
 * trabajando de verdad hacen más por la credibilidad que cualquier gráfico.
 *
 * No se recorta a cuadrado ni se uniformiza el color: parte de lo que las hace
 * creíbles es que no parezcan de banco de imágenes.
 */
import { Image } from 'astro:assets';
import type { Locale } from '../data/site';
import { content } from '../data/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale];

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/foto-*.{jpg,jpeg,png,webp}', {
  eager: true,
});
---

{
  t.photos.items.length > 0 && (
    <section class="light sec photos-sec" id="fotos">
      <div class="wrap">
        <div class="reveal">
          <p class="kick">{t.photos.kicker}</p>
          <h2 class="h-lg" style="margin-top:18px;">
            {t.photos.title[0]}
            <span class="teal">{t.photos.title[1]}</span>
          </h2>
        </div>

        <div class="photos reveal" data-stagger>
          {t.photos.items.map((f) => {
            const img = fotos[`../assets/${f.image}`]?.default;
            if (!img) return null;
            return (
              <figure class="photo">
                <Image
                  src={img}
                  alt={f.alt}
                  widths={[420, 760, 1100]}
                  sizes="(max-width: 720px) 92vw, 32vw"
                />
                <figcaption>{f.caption}</figcaption>
              </figure>
            );
          })}
        </div>
      </div>
    </section>
  )
}
